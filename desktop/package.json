{
  "name": "saif-navas-accounts",
  "productName": "Saif Navas Accounts",
  "version": "1.0.0",
  "description": "Saif Navas Transportation accounts software (desktop)",
  "main": "main.js",
  "author": "Saif Navas Transportation",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --publish never",
    "release": "npm run prepare-app && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/sora": "^5.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "firebase": "10.12.2"
  },
  "build": {
    "appId": "app.saifnavas.accounts",
    "productName": "Saif Navas Accounts",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "deleteAppDataOnUninstall": false },
    "publish": [{ "provider": "github", "owner": "shamnadeey", "repo": "saifnavas", "releaseType": "release" }]
  }
}
